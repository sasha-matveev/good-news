# ============================================================
# Good News — local runtime defaults (.env.example)
# ============================================================
#
# Copy to .env and adjust as needed for your local setup.
# DO NOT put secret values (GOOD_NEWS_APP_MASTER_KEY,
# GOOD_NEWS_POSTGRES_PASSWORD) in this file or in .env.
# Store secrets via one of the supported paths:
#
#   1. Export in your shell before running scripts.
#   2. Write to $HOME/.good-news/dev-secrets.env
#      (override path with GOOD_NEWS_LOCAL_SECRETS_FILE).
#   3. Store in Windows Credential Manager (recommended):
#        .\scripts\bootstrap.ps1 -AppMasterKey "..." -PostgresPassword "..."
#   4. For subprocess isolation, export to dotenv once:
#        .\scripts\export-secrets-to-dotenv.ps1
#
# Deploy the full stack locally:
#   .\scripts\deploy.ps1
# ============================================================

GOOD_NEWS_ENV=dev

# Host ports (change if defaults conflict with other local services)
GOOD_NEWS_POSTGRES_HOST_PORT=5432
GOOD_NEWS_CONTENT_API_SERVICE_HOST_PORT=8000
GOOD_NEWS_FRONTEND_HOST_PORT=5173
GOOD_NEWS_ANALYSIS_SERVICE_HOST_PORT=8100
GOOD_NEWS_SOURCE_INGESTION_SERVICE_HOST_PORT=8200
GOOD_NEWS_DELIVERY_SERVICE_HOST_PORT=8300
GOOD_NEWS_OLLAMA_HOST_PORT=11434

# Service host overrides for local development (used by inter-service callers)
GOOD_NEWS_CONTENT_API_SERVICE_HOST=localhost
GOOD_NEWS_CONTENT_API_SERVICE_PORT=8000
GOOD_NEWS_DELIVERY_SERVICE_HOST=localhost
GOOD_NEWS_DELIVERY_SERVICE_PORT=8300

# Public-facing origins (set automatically by deploy.ps1 when not present)
GOOD_NEWS_PUBLIC_CONTENT_API_ORIGIN=
GOOD_NEWS_PUBLIC_FRONTEND_ORIGIN=

# LLM model selection
GOOD_NEWS_OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M

# Observability stack ports (only relevant with --profile observability)
GOOD_NEWS_OBSERVABILITY_GRAFANA_HOST_PORT=3000
GOOD_NEWS_OBSERVABILITY_PROMETHEUS_HOST_PORT=9090
GOOD_NEWS_OBSERVABILITY_LOKI_HOST_PORT=3100
GOOD_NEWS_OBSERVABILITY_OTEL_GRPC_HOST_PORT=4317
GOOD_NEWS_OBSERVABILITY_OTEL_HTTP_HOST_PORT=4318
GOOD_NEWS_OBSERVABILITY_OTEL_HEALTH_HOST_PORT=13133
GOOD_NEWS_OBSERVABILITY_OTEL_METRICS_HOST_PORT=8888
GOOD_NEWS_OBSERVABILITY_RENDERER_HOST_PORT=8081

# Secrets path override (leave empty to use $HOME/.good-news/dev-secrets.env)
GOOD_NEWS_LOCAL_SECRETS_FILE=

# Secret placeholders — store actual values outside this file (see header comment)
GOOD_NEWS_APP_MASTER_KEY=
GOOD_NEWS_POSTGRES_PASSWORD=
