# ============================================================
# Good News — local development defaults (.env.example)
# ============================================================
#
# The app runs in Google Cloud (see README). This file only covers
# running the backend locally against a Neon dev branch.
#
# Copy to .env (or export in your shell) and fill in the values.
# DO NOT commit real secrets.
# ============================================================

GOOD_NEWS_ENV=dev

# Neon dev-branch connection string (postgresql+psycopg://...?sslmode=require)
GOOD_NEWS_DATABASE_URL=

# Encryption key for secrets stored in the database (SMTP password)
GOOD_NEWS_APP_MASTER_KEY=

# Gemini API key (aistudio.google.com/apikey)
GOOD_NEWS_GEMINI_API_KEY=
GOOD_NEWS_GEMINI_MODEL=gemini-2.5-flash-lite

# Leave unset locally: auth middleware and scheduler OIDC stay disabled.
# GOOD_NEWS_FIREBASE_PROJECT_ID=
# GOOD_NEWS_ALLOWED_EMAILS=
# GOOD_NEWS_SCHEDULER_INVOKER=
# GOOD_NEWS_OIDC_AUDIENCE=

# Public origins (used for absolute URLs in digest emails)
GOOD_NEWS_PUBLIC_CONTENT_API_ORIGIN=http://127.0.0.1:8000
GOOD_NEWS_PUBLIC_FRONTEND_ORIGIN=http://127.0.0.1:5173
